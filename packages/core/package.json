{
  "name": "@vite-electron-simple/core",
  "version": "2.0.0",
  "description": "一款支持在 vite 构建工具下，实现 react、electron 的开发、构建引入的脚手架，同时支持单一浏览器环境的开发和构建。支持全量的 vite 以及 electron-builder 的全部功能。支持 windows、macos 系统。",
  "keywords": [
    "commonjs",
    "electron",
    "electron-builder",
    "vite"
  ],
  "license": "ISC",
  "author": "vanner-young",
  "bin": {
    "mv-cli": "./bundle/index.js"
  },
  "files": [
    "bundle/**/*",
    "example/**/*",
    "README.md",
    "package.json"
  ],
  "main": "./bundle/index.js",
  "types": "./bundle/types",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "tsc",
    "prepublishOnly": "pnpm build",
    "build": "pnpm lint && rolldown -c rolldown.config.ts"
  },
  "dependencies": {
    "merge": "^2.1.1"
  },
  "devDependencies": {
    "@vite-electron-simple/plugin": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=42.0.0",
    "esbuild": ">=0.2.0",
    "mv-tsc-watch": "^0.0.3",
    "vite": ">=8.0.0"
  }
}
